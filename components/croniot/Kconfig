menu "Croniot logging (croniot::log)"

    config CRONIOT_LOG_ENABLE
        bool "Enable croniot::log (esp_log hook, RAM/RTC black box, drain task)"
        default y
        help
            Kill switch for the whole croniot::log platform layer. When
            disabled, croniot::log::init() installs no esp_log hook and
            creates no drain task - ESP-IDF's own default logging behavior
            is completely untouched.

    config CRONIOT_LOG_RAM_RECORDS
        int "RAM ring capacity (records)"
        default 32
        depends on CRONIOT_LOG_ENABLE
        help
            Number of LogRecord entries kept in the `.noinit` RAM ring
            (survives esp_restart()/panic/watchdog resets - NOT deep sleep
            or power loss). sizeof(LogRecord) is ~240 bytes on this
            target, so the default of 32 costs roughly 7.7 KB of HP SRAM -
            a deliberately modest slice of the ESP32-C6's ~512 KB, given
            this buffer competes with every other task's stack and the
            network stack's own buffers.

    config CRONIOT_LOG_RTC_RECORDS
        int "RTC critical store capacity (records)"
        default 6
        depends on CRONIOT_LOG_ENABLE
        help
            Number of LogRecord entries kept in RTC memory
            (RTC_NOINIT_ATTR), written only for Level::Error lines and
            croniot::log::event() calls - not every record. RTC memory is
            tiny and shared with other uses (e.g. Wi-Fi calibration data),
            so this targets roughly 1-2 KB: 6 records at ~240 bytes each
            is about 1.4 KB.

    config CRONIOT_LOG_TASK_STACK_SIZE
        int "croniot_log drain task stack size (bytes)"
        default 4096
        depends on CRONIOT_LOG_ENABLE

    config CRONIOT_LOG_TASK_PRIORITY
        int "croniot_log drain task priority"
        default 1
        depends on CRONIOT_LOG_ENABLE

    config CRONIOT_LOG_JOURNAL_LOW_WATER_MARK_PERCENT
        int "Journal low water mark (% free, reclaim starts)"
        default 20
        depends on CRONIOT_LOG_ENABLE
        help
            Plan §8.8. Below this much free space on the `journal` or
            `archive` partition, the space reclaimer starts freeing
            already-acked segments, then Data past its retention window,
            then Logs oldest-first.

    config CRONIOT_LOG_JOURNAL_CRITICAL_MARK_PERCENT
        int "Journal critical mark (% free, breaches retention window)"
        default 5
        depends on CRONIOT_LOG_ENABLE
        help
            Plan §8.8. Only below this much free space will the reclaimer
            breach the Data retention window itself (the last resort
            before Journal::maybeReclaim() reports degradedToRamOnly).
            Incidents, events and coredump are never sacrificed regardless
            of how critical space gets.

    config CRONIOT_LOG_JOURNAL_MAX_BYTES_PER_DAY
        int "Journal max bytes/day per stream before a write_budget_exceeded event (0 = no budget)"
        default 0
        depends on CRONIOT_LOG_ENABLE
        help
            Plan §3.10: "el presupuesto avisa, no recorta" - hardBudget is
            not implemented, so crossing this only raises one
            write_budget_exceeded event per stream per day. 0 (the
            default) disables the check entirely, matching the plan's
            "guardar todo" default.

endmenu

menu "Croniot telemetry uplink (croniot::telemetry)"

    config CRONIOT_UPLINK_TASK_STACK_SIZE
        int "croniot_uplink drain task stack size (bytes)"
        default 4096

    config CRONIOT_UPLINK_TASK_PRIORITY
        int "croniot_uplink drain task priority"
        default 4
        help
            Above croniot_log's drain task (default 1, see the logging
            menu) but below anything latency-critical - sending a batch
            can block briefly on the MQTT publish mutex.

    config CRONIOT_UPLINK_MAX_BATCH_RECORDS
        int "Max records per uplink batch"
        default 32

    config CRONIOT_UPLINK_MAX_BATCH_BYTES
        int "Max raw frame bytes per uplink batch"
        default 4096

    config CRONIOT_UPLINK_ACK_TIMEOUT_MS
        int "Milliseconds to wait for an application-level ack before the first retry"
        default 30000
        help
            Plan §5 point 5. This is the ack wait, not a network timeout -
            the MQTT publish itself returning success only means the
            broker (or, over BLE, nothing yet) has it; Journal::ack() is
            what actually confirms the server persisted it.

    config CRONIOT_UPLINK_BACKOFF_CAP_MS
        int "Backoff cap between retries (ms)"
        default 300000

    config CRONIOT_UPLINK_MAX_ATTEMPTS
        int "Attempts before a batch's link is marked degraded and retries pause"
        default 8
        help
            The batch's data is never dropped from the Journal on give-up
            - only this *attempt* stops retrying immediately; the next
            serviceOnce() pass picks the same unacked range back up.

endmenu
